<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fishbot">

    <xacro:include filename="$(find robot_description)/urdf/sim_robot/base.urdf.xacro" />
    <xacro:include filename="$(find robot_description)/urdf/sim_robot/sensor/imu.urdf.xacro" />
    <xacro:include filename="$(find robot_description)/urdf/sim_robot/sensor/laser.urdf.xacro" />
    <xacro:include filename="$(find robot_description)/urdf/sim_robot/sensor/camera.urdf.xacro" />
    <xacro:include filename="$(find robot_description)/urdf/sim_robot/actuator/wheel.urdf.xacro" />
    <xacro:include filename="$(find robot_description)/urdf/sim_robot/actuator/caster.urdf.xacro" />

    <xacro:include filename="$(find robot_description)/urdf/sim_robot/gazebo_classic.xacro" />

    <xacro:base_xacro length="0.12" radius="0.1" />
    <xacro:imu_xacro xyz="0 0 0.02" />
    <xacro:laser_xacro xyz="0 0 0.10" />
    <xacro:camera_xacro xyz="0.10 0 0.075" />
    <xacro:wheel_xacro wheel_name="left" xyz="0 0.10 -0.06" />
    <xacro:wheel_xacro wheel_name="right" xyz="0 -0.10 -0.06" />
    <xacro:caster_xacro caster_name="front" xyz="0.08 0.0 -0.076" />
    <xacro:caster_xacro caster_name="back" xyz="-0.08 0.0 -0.076" />

    <xacro:classic_diff_drive wheel_sep="0.20" wheel_diameter="0.064" />
    <xacro:classic_lidar />
    <xacro:classic_imu />

</robot>
